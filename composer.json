{
  "name": "martin-lechene/ebox-laravel",
  "description": "Laravel package for the Belgian e-Box Enterprise messaging system, with an AS4/ebMS3 push client (SOAP 1.2, WS-Security X.509, MTOM, gzip). Beta.",
  "type": "library",
  "keywords": [
    "laravel",
    "ebox",
    "e-box",
    "ebox-enterprise",
    "belgium",
    "as4",
    "ebms3",
    "messaging"
  ],
  "homepage": "https://github.com/martin-lechene/eBox-laravel",
  "license": "MIT",
  "authors": [
    {
      "email": "contact@doganddev.eu",
      "name": "Martin Lechene"
    }
  ],
  "support": {
    "issues": "https://github.com/martin-lechene/eBox-laravel/issues",
    "source": "https://github.com/martin-lechene/eBox-laravel",
    "email": "contact@doganddev.eu",
    "docs": "https://github.com/martin-lechene/eBox-laravel#readme"
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.5",
    "laravel/framework": "^12.0",
    "ramsey/uuid": "^4.7",
    "robrichards/xmlseclibs": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.0",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Ebox\\Enterprise\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ebox\\Enterprise\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "format-check": "pint --test"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Ebox\\Enterprise\\Providers\\EboxServiceProvider"
      ],
      "aliases": {
        "Ebox": "Ebox\\Enterprise\\Facades\\Ebox",
        "EboxAs4": "Ebox\\Enterprise\\Facades\\EboxAs4"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true
}
