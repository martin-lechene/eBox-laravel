{
    "name": "martin-lechene/ebox-laravel",
    "description": "Laravel package for e-Box Enterprise integration with Belgian government messaging system, featuring a real AS4/ebMS3 push client (SOAP 1.2, WS-Security X.509, MTOM, gzip)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Martin Lechene",
            "email": "martin@lechene.be"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^12.0",
        "guzzlehttp/guzzle": "^7.5",
        "ramsey/uuid": "^4.7",
        "robrichards/xmlseclibs": "^4.0",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Ebox\\Enterprise\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ebox\\Enterprise\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ebox\\Enterprise\\Providers\\EboxServiceProvider"
            ],
            "aliases": {
                "Ebox": "Ebox\\Enterprise\\Facades\\Ebox",
                "EboxAs4": "Ebox\\Enterprise\\Facades\\EboxAs4"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}